{
  "name": "@outfoot/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node ../../scripts/check-web-bundle.mjs dist/client --env-dir .",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "cf:preview": "npm run build && wrangler dev --local -c wrangler.jsonc",
    "cf:deploy": "npm run build && wrangler deploy -c wrangler.jsonc"
  },
  "dependencies": {
    "@outfoot/contracts": "*",
    "@primeuix/themes": "2.0.3",
    "pinia": "^4.0.3",
    "primevue": "4.5.5",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.136.1"
  }
}
