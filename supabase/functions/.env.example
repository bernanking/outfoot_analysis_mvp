# Edge Function 로컬 비밀값 예시입니다. 복사해 supabase/functions/.env로 쓰고 Git에 넣지 않습니다.
# SUPABASE_URL·SUPABASE_*_KEY(S)·SUPABASE_DB_URL은 Supabase가 함수에 자동 주입하므로 여기에 적지 않습니다(SUPABASE_ 접두사는 예약).
# 원격 값은 `supabase secrets set`으로 넣습니다(원격 자원 작업은 별도 승인 후).
APP_ENV=local
# mock 또는 disabled만 허용합니다. 실제 AI 공급자 키와 호출은 O06·O07 결정 전까지 추가하지 않습니다.
AI_MODE=mock
# 브라우저 요청을 허용할 웹 출처(쉼표로 구분, * 불가).
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
