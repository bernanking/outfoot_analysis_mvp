{
  "name": "outfoot-analysis-mvp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @outfoot/web",
    "build": "npm run build --workspace @outfoot/web",
    "preview": "npm run preview --workspace @outfoot/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "cf:preview": "npm run cf:preview --workspace @outfoot/web",
    "functions:check": "cd supabase/functions/api && npx --yes deno@2.9.6 check index.ts",
    "functions:serve": "supabase functions serve api --env-file supabase/functions/.env",
    "test:scripts": "node --test scripts/check-web-bundle.test.mjs scripts/eslint-boundaries.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "supabase": "2.119.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
