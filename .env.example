# 웹(Vite) 공개 설정 예시입니다. 복사해 apps/web/.env.local로 쓰고 Git에 넣지 않습니다.
# VITE_ 로 시작하는 값은 브라우저 번들에 그대로 들어갑니다. 서버 비밀값(Supabase secret·service_role 키, AI 키)을 넣지 않습니다.
VITE_APP_NAME=OUTFOOT
# Edge Function api의 /api/v1 기준 주소. 비워 두면 API를 호출하는 서비스가 설정 오류를 냅니다(현재 화면은 합성 데이터라 호출하지 않음).
# 로컬 Supabase 예: http://127.0.0.1:54321/functions/v1/api/v1
VITE_API_BASE_URL=
# 직원 로그인(Supabase Auth)을 연결하는 T03에서 사용합니다. publishable(공개) 키만 넣습니다.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
